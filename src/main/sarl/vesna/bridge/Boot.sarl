package vesna.bridge

import io.sarl.api.core.Initialize
import io.sarl.api.core.Lifecycle
import io.sarl.api.core.Logging

//starting point of the program, right click the file and start as 'sarl agent'
agent Boot {
	uses Lifecycle, Logging

	on Initialize {
		loggingName = "Boot Agent"
		
		// replace with the name of your bridge agent in vesna.bridge
		spawn(VesnaAgent)

		info("Program started. Boot agent shutting down.")
		killMe
	}
}