package vesna.events

import org.json.JSONObject

// event to send json packages to the virtual environment
event SendRequest {
	val type : String
	val data : JSONObject
	
	new(type : String, data : JSONObject) {
		this.type = type
		this.data = data
	}
}

// event to receive json packages from the virtual environment
event AnswerReceived {
	val jsonData : JSONObject
	val msg : String

	new(data : JSONObject, msg : String) {
		this.jsonData = data
		this.msg = msg
	}
}

// event to register the agent on a port in the bridge
event RegisterAgent {
	val myName : String
	val port : String
	//for extra data, put multiple things in a single string and separate them with a character like , or -
	val data : String
	
	new(myName : String, myPort : String, data : String) {
		this.myName = myName
		this.port = myPort
		this.data = data
	}
}