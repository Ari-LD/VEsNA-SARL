package vesna.agents

import io.sarl.api.core.Initialize
import io.sarl.api.core.Logging
import io.sarl.api.core.DefaultContextInteractions
import io.sarl.api.core.Behaviors

import vesna.capacities.VesnaNavigationCapacity
import vesna.capacities.OfficeWork
import vesna.capacities.OfficeCoffee

import vesna.skills.AgentWork
import vesna.skills.AgentCoffee

import vesna.events.CupValidation
import vesna.events.RequestTask
import vesna.events.StartTask

import vesna.map.OfficeMap

import org.json.JSONObject

abstract agent Worker extends TemplateAgent {
	uses Behaviors, Logging, VesnaNavigationCapacity, OfficeWork, OfficeCoffee, DefaultContextInteractions

	protected var myOffice : String
	protected var myDesk : String
	protected var myCup : String = null

	protected var currentTask : String = "NONE"
	
	val officeMap = new OfficeMap

	override getAdditionalData(occ : Initialize) : String {
		val data = new JSONObject()

		if (occ.parameters.length > 3) {
			this.myOffice = occ.parameters.get(2).toString
			this.myDesk = occ.parameters.get(3).toString

			data.put("office", occ.parameters.get(2).toString)
			data.put("desk", occ.parameters.get(3).toString)

			if (occ.parameters.length > 4 && occ.parameters.get(4) !== null) {
				data.put("cup", occ.parameters.get(4).toString)
				this.myCup = occ.parameters.get(4).toString
			}
		}

		return data.toString()
	}

	override setupSkills : void {
		super.setupSkills
		setSkill(new AgentWork(this.myDesk, this.myCup, getOfficeMap))
	}

	def getOfficeMap : OfficeMap {
		return this.officeMap
	}

	// if cup exists then sets the skill and the coffee machine instance
	on CupValidation [this.myCup !== null && occurrence.cup == this.myCup && occurrence.isAvailable == true] {
		setSkill(new AgentCoffee(this.myCup, occurrence.cupObject, occurrence.machine, getOfficeMap))
	}

	// this second event is only for if I want the agent to write this message if the cup doesn't exist
	// otherwise we could remove this one and also remove the boolean from the event
	on CupValidation [this.myCup !== null && occurrence.cup == this.myCup && occurrence.isAvailable == false] {
		info("my cup doesn't exist")
		
		setCup(null)
	}

	override onArrivalAtTarget {
		wake(new StartTask(this.currentTask))
	}

	on RequestTask {
		this.currentTask = occurrence.taskName
		if (currentTask == "COFFEE" && !hasSkill(OfficeCoffee)) {
			wake(new StartTask("WORK"))
		} else {
			val location = occurrence.location
			info("Requesting task: " + this.currentTask + " at " + location)
			goTo(location)
		}
	}

	on StartTask {
		this.currentTask = occurrence.taskName

		if (currentTask == "WORK") {
			info("Arrived at my desk, working.")
			work()
		} else if (currentTask == "COFFEE") {
			info("Finished working. Time for coffee.")
			makeCoffee()
		}
	}
}
