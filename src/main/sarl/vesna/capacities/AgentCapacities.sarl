package vesna.capacities

import env.playgrounds.office.CoffeeMachine

capacity OfficeWork {
	def getAssignedDesk : String
	
	def setCup(cup : String)

	def getCoffeeAmount : int
	def setCoffeeAmount(refill : int)
	
	def work

	def printStuff(content : String)

	def isAtDesk : boolean
}

capacity OfficeCoffee {
	def getCup : String
	
	def getMachine : CoffeeMachine
	
	def getIsHoldingCup : boolean
	def setIsHoldingCup(holding : boolean)
	
	def makeCoffee()
	
	def takeCup()
	
	def isAtCoffeeMachine : boolean
}